DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:5173
BEFOREBUY_E2E_TEST_CONTROLS=0
# Live AI remains opt-in. Never commit OPENAI_API_KEY or put it in frontend variables.
BEFOREBUY_AI_MODE=mock
BEFOREBUY_AI_SUPPORTED_REGION_CONFIRMED=0
OPENAI_API_KEY=
BEFOREBUY_AI_MODEL=gpt-6-luna
BEFOREBUY_AI_TIMEOUT_SECONDS=8
BEFOREBUY_AI_MAX_ATTEMPTS=2
BEFOREBUY_AI_MAX_INPUT_BYTES=8192
BEFOREBUY_AI_MAX_OUTPUT_TOKENS=512
BEFOREBUY_AI_PER_GUEST_DAILY_LIMIT=10
BEFOREBUY_AI_DAILY_BUDGET_USD=1.00
BEFOREBUY_AI_CIRCUIT_THRESHOLD=5
BEFOREBUY_AI_CIRCUIT_COOLDOWN_SECONDS=300
# No default: a live evaluation requires an explicit cap for that run.
BEFOREBUY_LIVE_EVAL_BUDGET_USD=
POSTGRES_DB=beforebuy
POSTGRES_USER=beforebuy
POSTGRES_PASSWORD=beforebuy-development
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55439
API_HOST_PORT=58000
