[Unit]
Description=Beforebuy daily expiry cleanup and PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=beforebuy
Group=beforebuy
WorkingDirectory=/opt/beforebuy
EnvironmentFile=/etc/beforebuy/maintenance.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/beforebuy/deploy/run-maintenance.sh
