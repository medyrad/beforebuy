# Non-secret production configuration. Keep secret values in restricted files.
DJANGO_ALLOWED_HOSTS=beforebuy.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://beforebuy.example
BEFOREBUY_HEALTHCHECK_HOST=beforebuy.example
DJANGO_SECURE_HSTS_SECONDS=3600
BEFOREBUY_AI_MODE=mock
BEFOREBUY_AI_PROVIDER=avalai
BEFOREBUY_AI_MODEL=gpt-5.6-luna
BEFOREBUY_AVALAI_ELIGIBILITY_CONFIRMED=0
BEFOREBUY_AI_TIMEOUT_SECONDS=8
BEFOREBUY_AI_MAX_ATTEMPTS=2
BEFOREBUY_AI_MAX_INPUT_BYTES=8192
BEFOREBUY_AI_MAX_OUTPUT_TOKENS=512
BEFOREBUY_AI_PER_GUEST_DAILY_LIMIT=10
BEFOREBUY_AI_DAILY_BUDGET_TOMAN=0
BEFOREBUY_AI_USD_TO_TOMAN_RATE=0
BEFOREBUY_AI_EXCHANGE_MARGIN_RATIO=0.15
BEFOREBUY_AI_CIRCUIT_THRESHOLD=5
BEFOREBUY_AI_CIRCUIT_COOLDOWN_SECONDS=300
COPILOT_AI_MODE=mock
COPILOT_PHASE12_SPENDING_AUTHORIZED=0
COPILOT_USD_TO_TOMAN_RATE=0
COPILOT_PHASE12_TOTAL_CAP_TOMAN=0
COPILOT_EXCHANGE_MARGIN_RATIO=0.15
COPILOT_OPERATION_CAP_MICROUSD=0
COPILOT_SESSION_CAP_MICROUSD=0
COPILOT_DAILY_CAP_MICROUSD=0
WEB_HTTPS_PORT=58443
TLS_CERT_PATH=/absolute/path/to/tls.crt
TLS_KEY_PATH=/absolute/path/to/tls.key
DJANGO_SECRET_KEY_FILE_PATH=/absolute/path/to/django-secret-key
POSTGRES_PASSWORD_FILE_PATH=/absolute/path/to/postgres-password
# Live only: add compose.production.live.yaml and set this to a restricted credential file.
# AVALAI_API_KEY_FILE_PATH=/absolute/path/to/avalai-api-key
